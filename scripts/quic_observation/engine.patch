+    use crate::connection::observation::trace_event;
+
+    fn event_fields(event: &str) -> std::collections::BTreeMap<&str, &str> {
+        let mut remaining = event
+            .trim_end()
+            .strip_prefix("engine cubic callback ")
+            .expect("invariant: callback message prefix is exact");
+        let mut fields = std::collections::BTreeMap::new();
+        while !remaining.is_empty() {
+            let (key, value) = remaining
+                .split_once('=')
+                .expect("invariant: callback field has a value");
+            let end = match value.as_bytes().first() {
+                Some(b'\"') => value[1..].find('\"').map_or(value.len(), |index| index + 2),
+                Some(b'[') => value.find(']').map_or(value.len(), |index| index + 1),
+                _ => value.find(' ').unwrap_or(value.len()),
+            };
+            let (value, rest) = value.split_at(end);
+            assert_eq!(fields.insert(key, value), None, "duplicate callback field");
+            remaining = rest.trim_start();
+        }
