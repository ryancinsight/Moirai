+//! Read-only diagnostic instrumentation; never published as a recovery fork.
+use super::{Connection, SpaceId, timer::Timer};
+use crate::Instant;
+
+impl Connection {
+    pub(super) fn observe_recovery(&self, reason: &str) {
+        if !tracing::enabled!(target: "quinn_proto::observation", tracing::Level::TRACE) {
+            return;
+        }
+        let now = Instant::now();
+        let mut spaces = Vec::new();
+        let mut queued = Vec::new();
+        let mut sent = Vec::new();
+        let mut acked = Vec::new();
+        for id in SpaceId::iter() {
+            let space = &self.spaces[id];
+            let number = id as u64;
+            spaces.push([number, u64::from(space.crypto.is_some()), space.next_packet_number,
+                space.rx_packet, space.crypto_offset, space.crypto_stream.bytes_read(),
+                space.sent_packets.len() as u64,
+                space.sent_packets.values().map(|p| u64::from(p.size)).sum(),
+                space.sent_packets.values().filter(|p| p.ack_eliciting).count() as u64,
+                space.pending.crypto.len() as u64, u64::from(space.pending_acks.can_send()),
+                u64::from(space.loss_probes)]);
+            queued.extend(space.pending.crypto.iter().map(|c|
+                [number, c.offset, c.data.len() as u64]));
+            for (pn, packet) in &space.sent_packets {
+                if let Some(retransmits) = packet.retransmits.get() {
+                    sent.extend(retransmits.crypto.iter().map(|c|
+                        [number, *pn, c.offset, c.data.len() as u64]));
+                }
+            }
+            if let Some(pn) = space.largest_acked_packet {
+                acked.push([number, pn]);
+            }
+        }
+        let timers: Vec<_> = Timer::VALUES.into_iter().filter_map(|timer|
+            self.timers.get(timer).map(|at| [timer as u64,
+                u64::try_from(at.saturating_duration_since(now).as_nanos())
+                    .expect("bounded diagnostic timer")])).collect();
+        let may_probe = !self.is_closed() && self.loss_time_and_space().is_none()
+            && (self.path.in_flight.ack_eliciting != 0 || !self.peer_completed_address_validation())
+            && (reason == "pto" || self.timers.get(Timer::LossDetection).is_some());
+        let pto: Vec<_> = if may_probe {
+            self.pto_time_and_space(now).into_iter().map(|(_, space)| space as u64).collect()
+        } else {
+            Vec::new()
+        };
+        let (credit, streams) = self.streams.observe_credit();
+        tracing::trace!(target: "quinn_proto::observation", reason,
+            flight_bytes = self.path.in_flight.bytes,
+            flight_packets = self.path.in_flight.ack_eliciting,
+            window_bytes = self.path.congestion.window(),
+            connection_max_data = credit[0],
+            connection_data_sent = credit[1],
+            buffered_data = credit[2],
+            send_window = credit[3],
+            engine_handshake = self.is_handshaking(),
+            tls_handshake = self.crypto.is_handshaking(),
+            spaces = ?spaces, queued = ?queued, sent = ?sent, acked = ?acked,
+            streams = ?streams, timers = ?timers, pto = ?pto,
+            "engine recovery state");
+    }
+}
