+            ),
+            ("persistent", expected.persistent.to_string()),
+            ("lost_bytes", expected.lost_bytes.to_string()),
+            (
+                "recovery_active_before",
+                expected.recovery_before.0.to_string(),
+            ),
+            (
+                "recovery_age_ns_before",
+                expected.recovery_before.1.to_string(),
+            ),
+            (
+                "sent_after_recovery_before",
+                expected.recovery_before.2.to_string(),
+            ),
+            ("recovery_active_after", recovery_after.0.to_string()),
+            ("recovery_age_ns_after", recovery_after.1.to_string()),
+            ("sent_after_recovery_after", recovery_after.2.to_string()),
+            ("state_before", format!("{:?}", expected.state_before)),
+            ("state_after", format!("{:?}", state(cubic))),
+        ];
+        assert_fields(event, &expected_fields);
+    }
+
+    fn ack(
+        cubic: &mut Cubic,
+        rtt: &RttEstimator,
+        now: Instant,
+        sent: Instant,
+        bytes: u64,
+        app_limited: bool,
+    ) {
+        let before = state(cubic);
+        let epoch_before = recovery(cubic, now, sent);
+        let outcome = if app_limited {
+            "app_limited"
+        } else if epoch_before.0 && !epoch_before.2 {
+            "recovery"
+        } else if before[0] < before[1] {
+            "slow_start"
+        } else {
+            "avoidance"
+        };
+        let event = trace_event(|| cubic.on_ack(now, sent, bytes, app_limited, rtt));
+        assert_callback(
+            cubic,
+            &event,
+            ExpectedCallback {
+                callback: "ack",
+                outcome,
+                bytes,
+                app_limited,
+                rtt_ns: u64::try_from(rtt.get().as_nanos())
+                    .expect("invariant: test RTT fits u64 nanoseconds"),
+                persistent: false,
+                lost_bytes: 0,
+                now,
+                sent,
+                state_before: before,
+                recovery_before: epoch_before,
+            },
+        );
+    }
+
+    #[test]
+    #[should_panic(expected = "bytes")]
+    fn callback_fields_reject_numeric_prefix_matches() {
+        assert_fields(
+            "engine cubic callback bytes=12000",
+            &[("bytes", "1200".into())],
+        );
+    }
+
+    fn congestion(
+        cubic: &mut Cubic,
+        now: Instant,
+        sent: Instant,
+        persistent: bool,
+        lost_bytes: u64,
+    ) {
+        let before = state(cubic);
+        let epoch_before = recovery(cubic, now, sent);
+        let outcome = if epoch_before.0 && !epoch_before.2 {
+            "recovery"
+        } else if persistent {
+            "persistent"
+        } else {
+            "loss"
+        };
+        let event = trace_event(|| {
+            cubic.on_congestion_event(now, sent, persistent, lost_bytes);
+        });
+        assert_callback(
+            cubic,
+            &event,
+            ExpectedCallback {
+                callback: "congestion",
+                outcome,
+                bytes: 0,
+                app_limited: false,
+                rtt_ns: 0,
+                persistent,
+                lost_bytes,
+                now,
+                sent,
+                state_before: before,
+                recovery_before: epoch_before,
+            },
+        );
+    }
+
+    fn cubic(now: Instant) -> Cubic {
+        Cubic::new(
+            Arc::new(CubicConfig::default()),
+            now,
+            BASE_DATAGRAM_SIZE as u16,
+        )
+    }
+
+    #[test]
+    fn callback_ack_guards_and_slow_start_are_observed() {
+        let now = Instant::now();
+        let rtt = RttEstimator::new(Duration::from_millis(100));
+        let mut value = cubic(now);
+        value.recovery_start_time = Some(now);
+        let unchanged = state(&value);
+        ack(&mut value, &rtt, now, now, 1_200, true);
+        assert_eq!(state(&value), unchanged);
+        for sent in [now - Duration::from_millis(1), now] {
+            ack(
+                &mut value,
+                &rtt,
+                now + Duration::from_millis(2),
+                sent,
+                1_200,
+                false,
+            );
+            assert_eq!(state(&value), unchanged);
+        }
+        value.recovery_start_time = None;
+        ack(&mut value, &rtt, now, now, 1_200, false);
+        assert_eq!(value.window, unchanged[0] + 1_200);
+        assert_eq!(value.recovery_start_time, None);
+    }
+
+    #[test]
+    fn callback_ack_avoidance_boundaries_are_observed() {
+        let now = Instant::now();
+        let rtt = RttEstimator::new(Duration::from_millis(100));
+        let mut initialized = cubic(now);
+        (initialized.window, initialized.ssthresh) = (12_000, 12_000);
+        ack(&mut initialized, &rtt, now, now, 1_200, false);
+        assert_eq!(
+            state(&initialized),
+            [
+                12_000,
+                12_000,
+                1_200,
+                0.0_f64.to_bits(),
+                12_000.0_f64.to_bits(),
+                0
+            ]
+        );
+        assert_eq!(initialized.recovery_start_time, Some(now));
+        for (increment, expected) in [(1_199, (12_000, 1_199)), (1_200, (13_200, 0))] {
+            let mut retained = cubic(now);
+            (retained.window, retained.ssthresh) = (12_000, 11_999);
+            retained.recovery_start_time = Some(now);
+            retained.cubic_state.w_max = 12_000.0;
+            retained.cubic_state.cwnd_inc = increment;
+            ack(
+                &mut retained,
+                &rtt,
+                now + Duration::from_millis(2),
+                now + Duration::from_millis(1),
+                1_200,
+                false,
+            );
+            assert_eq!((retained.window, retained.cubic_state.cwnd_inc), expected);
+            assert_eq!(retained.recovery_start_time, Some(now));
+        }
+    }
+
+    #[test]
+    fn callback_congestion_recovery_guard_precedes_persistence() {
+        let start = Instant::now();
+        let now = start + Duration::from_millis(2);
+        let mut value = cubic(start);
+        value.recovery_start_time = Some(start);
+        let unchanged = state(&value);
+        for sent in [start - Duration::from_millis(1), start] {
+            congestion(&mut value, now, sent, true, 1_337);
+            assert_eq!(state(&value), unchanged);
+            assert_eq!(value.recovery_start_time, Some(start));
+        }
+    }
+
+    #[test]
+    fn callback_congestion_loss_branches_preserve_exact_state() {
+        let start = Instant::now();
+        let now = start + Duration::from_millis(2);
+        let sent = start + Duration::from_millis(1);
+
+        let mut ordinary = cubic(start);
+        ordinary.window = 12_000;
+        ordinary.cubic_state.w_max = 6_000.0;
+        ordinary.cubic_state.cwnd_inc = 1_001;
+        congestion(&mut ordinary, now, sent, false, 1_337);
+        assert_eq!(ordinary.window, 8_400);
+        assert_eq!(ordinary.ssthresh, 8_400);
+        assert_eq!(ordinary.current_mtu, 1_200);
+        assert_eq!(ordinary.cubic_state.w_max.to_bits(), 12_000.0_f64.to_bits());
+        assert_eq!(ordinary.cubic_state.cwnd_inc, 700);
+        assert!(ordinary.cubic_state.k.is_finite() && ordinary.cubic_state.k >= 0.0);
+        assert_eq!(ordinary.recovery_start_time, Some(now));
+        let ordinary_k = ordinary.cubic_state.k.to_bits();
+
+        let mut fast = cubic(start);
+        fast.window = 9_600;
+        fast.cubic_state.w_max = 12_000.0;
+        fast.cubic_state.cwnd_inc = 10;
+        congestion(&mut fast, now, sent, false, 2_674);
+        assert_eq!((fast.window, fast.ssthresh), (6_720, 6_720));
+        assert_eq!(fast.cubic_state.w_max.to_bits(), 8_160.0_f64.to_bits());
+        assert_eq!(fast.cubic_state.cwnd_inc, 7);
+        assert!(fast.cubic_state.k.is_finite() && fast.cubic_state.k >= 0.0);
+
+        let mut clamped = cubic(start);
+        clamped.window = 2_401;
+        clamped.cubic_state.w_max = 0.0;
+        clamped.cubic_state.cwnd_inc = 1;
+        congestion(&mut clamped, now, sent, false, 4_011);
+        assert_eq!((clamped.window, clamped.ssthresh), (2_400, 2_400));
+        assert_eq!(clamped.cubic_state.w_max.to_bits(), 2_401.0_f64.to_bits());
+        assert_eq!(clamped.cubic_state.cwnd_inc, 0);
+        assert!(clamped.cubic_state.k.is_finite() && clamped.cubic_state.k >= 0.0);
+
+        let mut persistent = cubic(start);
+        persistent.window = 12_000;
+        persistent.cubic_state.w_max = 6_000.0;
+        persistent.cubic_state.cwnd_inc = 1_001;
+        congestion(&mut persistent, now, sent, true, 5_348);
+        assert_eq!(persistent.window, 2_400);
+        assert_eq!(persistent.ssthresh, 5_880);
+        assert_eq!(persistent.current_mtu, 1_200);
+        assert_eq!(persistent.cubic_state.k.to_bits(), ordinary_k);
+        assert_eq!(
+            persistent.cubic_state.w_max.to_bits(),
+            8_400.0_f64.to_bits()
+        );
+        assert_eq!(persistent.cubic_state.cwnd_inc, 0);
+        assert_eq!(persistent.recovery_start_time, None);
+    }
