 impl StreamsState {
+    /// Numeric metadata only; no stream payload is inspected.
+    pub(crate) fn observe_credit(&self) -> ([u64; 4], Vec<[u64; 5]>) {
+        let mut rows: Vec<_> = self.send.iter().filter_map(|(id, send)| {
+            let send = send.as_ref()?;
+            Some([u64::from(*id), send.pending.offset(), send.max_data,
+                u64::from(send.pending.has_unsent_data()), u64::from(send.connection_blocked)])
+        }).collect();
+        rows.sort_unstable_by_key(|row| row[0]);
+        ([self.max_data, self.data_sent, self.buffered_data, self.send_window], rows)
+    }
