+#[cfg(quic_observation)]
+#[test]
+fn pair_pacing_block_reports_native_deadline_and_resumes() {
+    const MTU: u16 = 1_200;
+    const WINDOW: u64 = 24_000;
+    const RTT: Duration = Duration::from_millis(100);
+
+    let mut cubic = crate::congestion::CubicConfig::default();
+    cubic.initial_window(WINDOW);
+    let mut transport = TransportConfig::default();
+    transport
+        .initial_rtt(RTT)
+        .initial_mtu(MTU)
+        .min_mtu(MTU)
+        .mtu_discovery_config(None)
+        .pad_to_mtu(true)
+        .congestion_controller_factory(Arc::new(cubic));
+    let mut client = client_config();
+    client.transport_config(Arc::new(transport));
+    let mut endpoint = EndpointConfig::default();
+    endpoint
+        .max_udp_payload_size(MTU)
+        .expect("invariant: QUIC minimum datagram size is valid");
+    let mut pair = Pair::new(Arc::new(endpoint), server_config());
+    pair.mtu = usize::from(MTU);
+    let (handle, _) = pair.connect_with(client);
+    let now = pair.time;
+    let connection = pair.client_conn_mut(handle);
+    assert_eq!(connection.bytes_in_flight(), 0);
+    connection.path_changed(now);
+    assert_eq!(connection.stats().path.cwnd, WINDOW);
+    assert_eq!(connection.rtt(), RTT);
+    let stream = connection
+        .streams()
+        .open(Dir::Uni)
+        .expect("invariant: connected peer permits a unidirectional stream");
+    assert_eq!(
+        connection
+            .send_stream(stream)
+            .write(&vec![37; usize::from(MTU) * 16]),
+        Ok(usize::from(MTU) * 16)
+    );
+    let mut buffer = Vec::with_capacity(usize::from(MTU));
+    for _ in 0..10 {
+        let transmit = connection
+            .poll_transmit(now, 1, &mut buffer)
+            .expect("invariant: queued stream data produces one datagram");
+        assert_eq!((transmit.size, buffer.len()), (usize::from(MTU), usize::from(MTU)));
+        buffer.clear();
+    }
+    assert_eq!(connection.bytes_in_flight(), 12_000);
+
+    let event = trace_event_with_field("delay_ns", || {
+        assert_matches!(connection.poll_transmit(now, 1, &mut buffer), None);
+    });
+    assert_eq!(
+        event.trim_end(),
+        "engine pacing blocked flight_bytes=12000 bytes_to_send=1200 window_bytes=24000 smoothed_rtt_ns=100000000 delay_ns=40000000"
+    );
+    // The native bucket holds 10 MTUs, so its empty-bucket deadline is
+    // 100 ms * (12_000 / 24_000) * (4 / 5) = 40 ms.
+    let deadline = now + Duration::from_millis(40);
+    assert_eq!(connection.poll_timeout(), Some(deadline));
+    connection.handle_timeout(deadline);
+    let resumed = connection
+        .poll_transmit(deadline, 1, &mut buffer)
+        .expect("invariant: native pacing deadline replenishes the token bucket");
+    assert_eq!((resumed.size, buffer.len()), (usize::from(MTU), usize::from(MTU)));
+}
+
+#[cfg(quic_observation)]
+#[test]
+fn pair_congestion_block_reports_native_guard_and_resumes_after_ack() {
+    const MTU: u16 = 1_200;
+    const WINDOW: u64 = 12_000;
+
+    let mut cubic = crate::congestion::CubicConfig::default();
+    cubic.initial_window(WINDOW);
+    let mut transport = TransportConfig::default();
+    transport
+        .initial_mtu(MTU)
+        .min_mtu(MTU)
+        .mtu_discovery_config(None)
+        .pad_to_mtu(true)
+        .congestion_controller_factory(Arc::new(cubic));
+    let mut client = client_config();
+    client.transport_config(Arc::new(transport));
+    let mut endpoint = EndpointConfig::default();
+    endpoint
+        .max_udp_payload_size(MTU)
+        .expect("invariant: QUIC minimum datagram size is valid");
+    let mut pair = Pair::new(Arc::new(endpoint), server_config());
+    pair.mtu = usize::from(MTU);
+    let (handle, _) = pair.connect_with(client);
+    let now = pair.time;
+    let (event, packets) = {
+        let connection = pair.client_conn_mut(handle);
+        assert_eq!(connection.bytes_in_flight(), 0);
+        connection.path_changed(now);
+        assert_eq!(connection.stats().path.cwnd, WINDOW);
+        let stream = connection
+            .streams()
+            .open(Dir::Uni)
+            .expect("invariant: connected peer permits a unidirectional stream");
+        assert_eq!(
+            connection
+                .send_stream(stream)
+                .write(&vec![41; usize::from(MTU) * 16]),
+            Ok(usize::from(MTU) * 16)
+        );
+        let mut packets = Vec::with_capacity(9);
+        let mut buffer = Vec::with_capacity(usize::from(MTU));
+        for _ in 0..9 {
+            let transmit = connection
+                .poll_transmit(now, 1, &mut buffer)
+                .expect("invariant: available congestion credit sends one datagram");
+            assert_eq!((transmit.size, buffer.len()), (usize::from(MTU), usize::from(MTU)));
+            packets.push((transmit, Bytes::copy_from_slice(&buffer)));
+            buffer.clear();
+        }
+        assert_eq!(connection.bytes_in_flight(), 10_800);
+        let event = trace_event_with_field("congestion_window_bytes", || {
+            assert_matches!(connection.poll_transmit(now, 1, &mut buffer), None);
+        });
+        (event, packets)
+    };
+    assert_eq!(
+        event.trim_end(),
+        "engine congestion blocked flight_bytes=10800 bytes_to_send=1200 congestion_window_bytes=12000"
+    );
+
+    pair.client.outbound.extend(packets);
+    pair.drive_client();
+    pair.drive_server();
+    assert_eq!(pair.client.inbound.len(), 1);
+    let now = pair.time;
+    let remote = pair.server.addr;
+    pair.client.drive_incoming(now, remote);
+    assert_eq!(pair.client.outbound.len(), 0);
+    pair.client.drive_outgoing(now);
+    let (resumed, buffer) = pair
+        .client
+        .outbound
+        .front()
+        .expect("invariant: a real peer ACK releases congestion credit");
+    assert_eq!((resumed.size, buffer.len()), (usize::from(MTU), usize::from(MTU)));
+}
